# Environment variables for the Telangana SI 2026 Coaching System
#
# HOW TO USE THIS FILE
#   1. Make a copy of it in this same folder and name the copy exactly:  .env
#   2. Put your real API keys in that copy.
#   3. Never rename this example file itself, and never put a real key in it.
#
# The file named  .env  is excluded from Git, so your keys stay off the record.
# This example file IS tracked, so it can document what the project needs.
#
# If a real key ever ends up committed to Git, treat it as public: revoke it and
# issue a new one. Deleting it in a later commit does not remove it from history.

# --- Anthropic (Claude) — decision D-0005 ---
ANTHROPIC_API_KEY=replace_me

# --- GLM / Z.ai (GLM 5.3) — decision D-0005 ---
GLM_API_KEY=replace_me
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# --- Local application settings ---
# Single-user local system (decision D-0001). Binding to 127.0.0.1 keeps the API
# off the network. There is no authentication, so changing this to 0.0.0.0 would
# publish an unauthenticated API to your entire network. Do not change it.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# Path to the SQLite database file, relative to the project folder.
DATABASE_PATH=data/si_coach.db

# Set to 1 to make the system refuse to answer from UNVERIFIED knowledge.
# Recommended: leave at 1. See VERIFICATION_POLICY.md.
REQUIRE_VERIFIED_KNOWLEDGE=1
